{
  "name": "@rebook/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist --minify",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun src/db/seed.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.1",
    "@elysiajs/jwt": "^1.1.1",
    "@elysiajs/swagger": "^1.1.6",
    "@node-rs/bcrypt": "^1.10.4",
    "@rebook/shared": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "elysia": "^1.1.26",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.13",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.28.1",
    "drizzle-zod": "^0.5.1",
    "pino-pretty": "^11.3.0",
    "typescript": "^5.6.3"
  }
}
